# Docker Compose secrets. Copy this file to .env before running docker compose.
POSTGRES_PASSWORD=change-this-postgres-password
# Base64-encoded key with at least 256 bits of entropy.
JWT_SECRET=replace-with-a-secure-base64-jwt-secret

# Local development. On AWS, set these to your HTTPS domain and port 80.
PUBLIC_ORIGIN=http://localhost:5173
APP_PORT=5173
COOKIE_SECURE=false
