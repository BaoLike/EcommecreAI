BUSINESS_API_URL=http://localhost:8080/api
# Trusted Spring base URL used only to validate the forwarded HttpOnly auth cookie.
AI_IDENTITY_API_URL=http://localhost:8080/api
AI_IDENTITY_COOKIE_NAME=baolikeEcom
AI_ALLOWED_ORIGINS=http://localhost:5173
AI_CATALOG_TIMEOUT_SECONDS=5
AI_MAX_CATALOG_PAGES=10
AI_MAX_RESULTS=5

# Optional OpenAI-compatible provider. Leave blank to use the grounded fallback response.
# Ollama example: http://localhost:11434/v1
# For Ollama, the assistant uses the native /api/chat path and disables thinking.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_PROVIDER=
LLM_TIMEOUT_SECONDS=20
LLM_CONNECT_TIMEOUT_SECONDS=2
LLM_MAX_TOKENS=400

# Optional RAG persistence. PostgreSQL must have the pgvector extension installed.
# Use a database/user that can create the extension once, then apply sql/001_rag.sql.
AI_RAG_DATABASE_URL=
# Example: postgresql://postgres:<your-local-password>@localhost:5432/Ecommerce

# Persistent chat history and user memory. It can share the RAG database.
# Example: postgresql://postgres:<your-local-password>@localhost:5432/Ecommerce
AI_MEMORY_DATABASE_URL=
AI_MEMORY_TIMEOUT_SECONDS=5
AI_IDENTITY_TIMEOUT_SECONDS=3

# Optional OpenAI-compatible embeddings API. Leave blank to use local keyword retrieval.
# Keep its embedding model the same between ingestion and chat.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_TIMEOUT_SECONDS=300
AI_RAG_MAX_CHUNKS=4
AI_RAG_TIMEOUT_SECONDS=5
# Optional absolute or working-directory-relative path; defaults to ./knowledge_base.
AI_KNOWLEDGE_DIR=
